# ---------------------------------------------------------------------------
# Secrets: never commit real env files (templates end in .example)
# ---------------------------------------------------------------------------
/.env
/.env.*
!/.env.example
!/.env.railway.example

# ---------------------------------------------------------------------------
# Local runtime data (JSON fallback storage, tokens, metrics)
# ---------------------------------------------------------------------------
data/**/*.json
data/**/*.pickle
data/chromadb/
data/metrics/
# Labelled incident datasets for the triage eval are committed
!data/triage/**/*.json
src/memory/*.json
!data/**/.gitkeep

# Frontend build cache
frontend/.vite/
